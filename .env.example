# Keelung Sights Viewer - Environment Variables

# MongoDB Root User (for container initialization)
MONGODB_USER=admin
MONGODB_PASSWORD=password

# MongoDB Application User (for application connection)
MONGODB_APP_USER=sightsUser
MONGODB_APP_PASSWORD=sightsPassword

# MongoDB Connection Settings
MONGODB_HOST=mongodb
MONGODB_PORT=27017

# Application Configuration
PORT=8080

# For local development (without Docker)
# MONGODB_HOST=localhost
# MONGODB_PORT=27017

# For MongoDB Atlas (comment out above and uncomment below if using cloud MongoDB)
# MONGODB_APP_USER=your_atlas_username
# MONGODB_APP_PASSWORD=your_atlas_password
